      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Physical Register File unificado — ARF + RRF" style="text;html=1;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="760" height="45" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Cada registrador físico contém valor e estado; as transições mostram seu ciclo de vida" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="800" height="28" as="geometry"/></mxCell>

        <!-- Unified PRF contents -->
