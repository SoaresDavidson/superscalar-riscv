        <mxCell id="prf-p3" value="P3  |  RB_NOT_VALID  |  0  |  —" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="330" y="455" width="510" height="55" as="geometry"/></mxCell>
        <mxCell id="prf-p4" value="P4  |  RB_VALID  |  1  |  value" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="330" y="510" width="510" height="55" as="geometry"/></mxCell>
        <mxCell id="prf-px" value="…  |  …  |  …  |  …" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#60A5FA;fontSize=14;" vertex="1" parent="1"><mxGeometry x="330" y="565" width="510" height="55" as="geometry"/></mxCell>
