        <mxCell id="prf-semantics" value="AR: valor arquitetural confirmado&lt;br&gt;FREE: entrada disponível para alocação&lt;br&gt;RB_NOT_VALID: alocada, aguardando writeback&lt;br&gt;RB_VALID: resultado especulativo pronto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#60A5FA;fontSize=13;align=left;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="330" y="700" width="510" height="90" as="geometry"/></mxCell>

