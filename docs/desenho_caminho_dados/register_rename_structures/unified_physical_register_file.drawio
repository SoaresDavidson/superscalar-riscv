        <mxCell id="prf-note" value="N entradas físicas — registradores arquiteturais e de rename no mesmo array" style="text;html=1;align=center;fontSize=12;fontColor=#1E40AF;" vertex="1" parent="1"><mxGeometry x="330" y="190" width="510" height="28" as="geometry"/></mxCell>
