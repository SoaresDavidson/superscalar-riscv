        <mxCell id="subtitle" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#64748B;fontStyle=0;" value="Organização da seção 5.3.3 do Shen &amp;amp; Lipasti sobre os blocos do core. Tracejado: não implementado ou opcional." vertex="1"><mxGeometry x="40" y="62" width="1300" height="30" as="geometry"/></mxCell>
        <mxCell id="lA" parent="1" style="swimlane;html=1;rounded=1;startSize=38;horizontal=1;fillColor=#DBEAFE;swimlaneFillColor=#F8FAFC;strokeColor=#2563EB;fontColor=#1E3A8A;fontStyle=1;fontSize=15;" value="ISSUE / ENDEREÇO" vertex="1"><mxGeometry x="30" y="130" width="330" height="830" as="geometry"/></mxCell>
        <mxCell id="lB" parent="1" style="swimlane;html=1;rounded=1;startSize=38;horizontal=1;fillColor=#FFEDD5;swimlaneFillColor=#FFFAF5;strokeColor=#EA580C;fontColor=#7C2D12;fontStyle=1;fontSize=15;" value="LOAD" vertex="1"><mxGeometry x="400" y="130" width="560" height="330" as="geometry"/></mxCell>
        <mxCell id="lC" parent="1" style="swimlane;html=1;rounded=1;startSize=38;horizontal=1;fillColor=#EDE9FE;swimlaneFillColor=#FAF8FF;strokeColor=#7C3AED;fontColor=#4C1D95;fontStyle=1;fontSize=15;" value="STORE BUFFER (FIFO)" vertex="1"><mxGeometry x="400" y="500" width="560" height="300" as="geometry"/></mxCell>
        <mxCell id="lF" parent="1" style="swimlane;html=1;rounded=1;startSize=38;horizontal=1;fillColor=#EDE9FE;swimlaneFillColor=#FAF8FF;strokeColor=#7C3AED;fontColor=#4C1D95;fontStyle=1;fontSize=15;" value="LOAD BUFFER" vertex="1"><mxGeometry x="400" y="830" width="560" height="130" as="geometry"/></mxCell>
        <mxCell id="lD" parent="1" style="swimlane;html=1;rounded=1;startSize=38;horizontal=1;fillColor=#F1F5F9;swimlaneFillColor=#FAFAFA;strokeColor=#475569;fontColor=#1E293B;fontStyle=1;fontSize=15;" value="HIERARQUIA DE MEMÓRIA" vertex="1"><mxGeometry x="1000" y="130" width="300" height="830" as="geometry"/></mxCell>
        <mxCell id="lE" parent="1" style="swimlane;html=1;rounded=1;startSize=38;horizontal=1;fillColor=#DCFCE7;swimlaneFillColor=#F6FFF8;strokeColor=#16A34A;fontColor=#14532D;fontStyle=1;fontSize=15;" value="COMPLETION / COMMIT" vertex="1"><mxGeometry x="1340" y="130" width="450" height="830" as="geometry"/></mxCell>
        <mxCell id="rsmem" parent="lA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=15;fontColor=#1E3A8A;" value='&lt;b&gt;RS de memória (rs_mem)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px;font-weight:normal"&gt;lê src1/src2 do PRF no issue&lt;/font&gt;' vertex="1"><mxGeometry x="30" y="60" width="270" height="80" as="geometry"/></mxCell>
        <mxCell id="agu" parent="lA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=15;fontColor=#1E3A8A;" value='&lt;b&gt;AGU&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px;font-weight:normal"&gt;endereço = src1 + imm (XLEN)&lt;br&gt;desalinhado → exceção&lt;/font&gt;' vertex="1"><mxGeometry x="30" y="210" width="270" height="100" as="geometry"/></mxCell>
        <mxCell id="tlb" parent="lA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;fontSize=15;fontColor=#1E293B;dashed=1;dashPattern=6 4;" value='&lt;b&gt;TLB&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px;font-weight:normal"&gt;não implementada:&lt;br&gt;endereço virtual = físico&lt;/font&gt;' vertex="1"><mxGeometry x="30" y="390" width="270" height="80" as="geometry"/></mxCell>
        <mxCell id="nstore" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#991B1B;fontStyle=0;" value="Dado do store (src2): na etapa 1 vai junto com o endereço, pela porta agu_store_data (ver Memory, item 3)." vertex="1"><mxGeometry x="60" y="640" width="270" height="60" as="geometry"/></mxCell>
        <mxCell id="mux" parent="lB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=15;fontColor=#78350F;" value='&lt;b&gt;MUX de forwarding&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px;font-weight:normal"&gt;match → dado do store&lt;br&gt;sem match → dado da cache&lt;/font&gt;' vertex="1"><mxGeometry x="300" y="60" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="ext" parent="lB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=2;fontSize=15;fontColor=#7C2D12;" value='&lt;b&gt;Extensão de sinal / zero&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px;font-weight:normal"&gt;LB, LBU, LH, LHU, LW, LWU, LD&lt;/font&gt;' vertex="1"><mxGeometry x="300" y="210" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="search" parent="lC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=15;fontColor=#78350F;" value='&lt;b&gt;Busca associativa (CAM)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px;font-weight:normal"&gt;um comparador por entrada, de head até a cor do load:&lt;br&gt;sobreposição com o endereço do load → match e dado do store mais novo&lt;/font&gt;' vertex="1"><mxGeometry x="30" y="50" width="500" height="80" as="geometry"/></mxCell>
        <mxCell id="fin" parent="lC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;fontSize=15;fontColor=#4C1D95;" value='&lt;b&gt;Finished&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px;font-weight:normal"&gt;especulativo: endereço, dado, idade&lt;br&gt;flush descarta&lt;/font&gt;' vertex="1"><mxGeometry x="30" y="170" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="cmp" parent="lC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;fontSize=15;fontColor=#4C1D95;" value='&lt;b&gt;Completed&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px;font-weight:normal"&gt;já fez commit&lt;br&gt;espera a porta de escrita&lt;/font&gt;' vertex="1"><mxGeometry x="310" y="170" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="flb" parent="lF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;fontSize=15;fontColor=#4C1D95;" value='&lt;b&gt;Load buffer (finished load buffer)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px;font-weight:normal"&gt;endereço e tamanho dos loads já executados; quando um store executa,&lt;br&gt;compara com as entradas finished mais novas que ele&lt;/font&gt;' vertex="1"><mxGeometry x="30" y="42" width="500" height="70" as="geometry"/></mxCell>
        <mxCell id="dc" parent="lD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;fontSize=15;fontColor=#1E293B;" value='&lt;b&gt;D-cache L1&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px;font-weight:normal"&gt;porta de load (prioridade)&lt;br&gt;porta de escrita (stores)&lt;/font&gt;' vertex="1"><mxGeometry x="30" y="60" width="240" height="120" as="geometry"/></mxCell>
        <mxCell id="mlq" parent="lD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;fontSize=15;fontColor=#1E293B;dashed=1;dashPattern=6 4;" value='&lt;b&gt;Missed load queue&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px;font-weight:normal"&gt;recebe os misses&lt;br&gt;cache não bloqueante (opcional)&lt;/font&gt;' vertex="1"><mxGeometry x="100" y="230" width="190" height="90" as="geometry"/></mxCell>
        <mxCell id="l2" parent="lD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;fontSize=15;fontColor=#1E293B;" value='&lt;b&gt;L2 / DRAM&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px;font-weight:normal"&gt;entrega linhas inteiras&lt;/font&gt;' vertex="1"><mxGeometry x="100" y="360" width="190" height="70" as="geometry"/></mxCell>
        <mxCell id="cpl" parent="lE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=15;fontColor=#14532D;" value='&lt;b&gt;completion&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px;font-weight:normal"&gt;dado do load → PRF (write-back) e wakeup das RS&lt;br&gt;AGU → ROB: só stores e exceções&lt;/font&gt;' vertex="1"><mxGeometry x="40" y="60" width="370" height="100" as="geometry"/></mxCell>
        <mxCell id="rob" parent="lE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=15;fontColor=#14532D;" value='&lt;b&gt;ROB (retire_team)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px;font-weight:normal"&gt;commit em ordem de programa&lt;br&gt;st_commit · ld_commit · flush · lsu_ready&lt;/font&gt;' vertex="1"><mxGeometry x="40" y="270" width="370" height="130" as="geometry"/></mxCell>
        <mxCell id="nfence" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#14532D;fontStyle=0;" value="&lt;b&gt;fence&lt;/b&gt; (decisão 9, em aberto): proposta de esperar o store buffer esvaziar.&lt;br&gt;&lt;b&gt;Exceção&lt;/b&gt;: esvazia a parte completed antes do trap." vertex="1"><mxGeometry x="1460" y="570" width="280" height="70" as="geometry"/></mxCell>
